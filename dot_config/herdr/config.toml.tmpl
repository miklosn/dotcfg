onboarding = false
[terminal]
{{ if eq .chezmoi.os "darwin" -}}
default_shell = "/opt/homebrew/bin/fish"
{{- else -}}
default_shell = "/usr/bin/fish"
{{- end }}

[theme]
name = "gruvbox"
auto_switch = false

[ui]
show_agent_labels_on_pane_borders = false

[ui.sound]
enabled = false

# Desktop sidebar: show the agent's own terminal title (Claude sets a task
# summary) so panes are distinguishable. Mobile/collapsed views ignore this
# and show the tab label instead; herdr-autotitle keeps those in sync.
[ui.sidebar.agents]
rows = [
  ["state_icon", "agent", "state_text"],
  ["terminal_title_stripped"],
  ["workspace", "tab"],
]
