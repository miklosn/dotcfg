onboarding = false
[terminal]
{{ if eq .chezmoi.os "darwin" -}}
default_shell = "/opt/homebrew/bin/fish"
{{- else -}}
default_shell = "/usr/bin/fish"
{{- end }}

[theme]
name = "gruvbox"
auto_switch = false

[ui]
show_agent_labels_on_pane_borders = false

[ui.sound]
enabled = false

# Sidebar rows. A workspace is a project; its tabs are separate work streams
# on possibly different branches, so the branch belongs on the tab label
# (herdr-autotitle puts it there), not on the space row.
[ui.sidebar.agents]
rows = [
  ["state_icon", "workspace", "tab"],
  ["agent", "state_text"],
]

[ui.sidebar.spaces]
rows = [
  ["state_icon", "workspace"],
  ["git_status"],
]
