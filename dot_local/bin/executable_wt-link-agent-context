#!/usr/bin/env bash
# In a linked git worktree, symlink gitignored agent context files from the main
# checkout with *relative* links (absolute ones break across the mac <-> VM
# /mnt/mac mount). wtp post_create hook; no-op in the main checkout.
set -euo pipefail
wt="$(git rev-parse --show-toplevel)"
main="$(cd "$wt" && cd "$(git rev-parse --git-common-dir)/.." && pwd)"
[ "$main" != "$wt" ] || exit 0
for f in "${@:-AGENTS.md CLAUDE.md .claude .wtp.yml}"; do
  [ -e "$main/$f" ] || continue
  [ -e "$wt/$f" ] && continue
  ln -s "$(python3 -c "import os,sys;print(os.path.relpath(sys.argv[1],sys.argv[2]))" "$main/$f" "$wt")" "$wt/$f"
done
