#!/usr/bin/env bash
# wt — git worktrees the same way in every repo, no repo-side config.
#
#   wt new <branch> [base]   create (or check out) <branch> in a sibling worktree,
#                            link gitignored agent context, register in herdr
#   wt path <branch>         print the worktree path for <branch>
#   wt ls                    list worktrees
#   wt rm <branch|path>      git worktree remove (never deletes the branch)
#   wt link                  (re)link agent context into the current worktree
#   wt register              (re)register the current worktree in herdr
#
# Layout: main checkout M -> worktrees at $(dirname M)/worktrees/<branch> when
# M's parent is a *.nosync project dir (the ~/c convention), otherwise at
# $(dirname M)/<name>.worktrees/<branch>.
set -euo pipefail

die() { echo "wt: $*" >&2; exit 1; }

main_checkout() {
  local top common
  top="$(git rev-parse --show-toplevel 2>/dev/null)" || die "not in a git repo"
  common="$(git rev-parse --git-common-dir)"
  (cd "$top" && cd "$common/.." && pwd)
}

project_name() { # <main>
  local parent; parent="$(basename "$(dirname "$1")")"
  case "$parent" in *.nosync) echo "${parent%.nosync}";; *) basename "$1";; esac
}

worktree_root() { # <main>
  local parent; parent="$(dirname "$1")"
  case "$(basename "$parent")" in
    *.nosync) echo "$parent/worktrees";;
    *) echo "$parent/$(basename "$1").worktrees";;
  esac
}

# Relative symlinks (absolute ones break across the mac <-> VM /mnt/mac mount)
# for context files that ~/.gitignore keeps out of the repo.
link_context() { # <main> <wt>
  local f rel
  for f in AGENTS.md CLAUDE.md .claude .wtp.yml; do
    [ -e "$1/$f" ] || continue
    [ -e "$2/$f" ] && continue
    rel="$(python3 -c 'import os,sys;print(os.path.relpath(sys.argv[1],sys.argv[2]))' "$1/$f" "$2")"
    ln -s "$rel" "$2/$f"
  done
}

# Open the worktree as a herdr workspace grouped under the main checkout's
# workspace, labelled project/branch (same scheme herdr-autotitle uses).
register_herdr() { # <main> <wt> <branch>
  command -v herdr >/dev/null || return 0
  [ -S "${HERDR_SOCKET_PATH:-$HOME/.config/herdr/herdr.sock}" ] || return 0
  local label; label="$(project_name "$1")/$3"
  herdr worktree open --cwd "$1" --path "$2" --label "$label" --no-focus >/dev/null 2>&1 \
    || herdr workspace create --cwd "$2" --label "$label" --no-focus >/dev/null 2>&1 || true
}

cmd_new() {
  local branch="${1:-}" base="${2:-}" main wt
  [ -n "$branch" ] || die "usage: wt new <branch> [base]"
  main="$(main_checkout)"
  wt="$(worktree_root "$main")/$branch"
  if [ -d "$wt" ]; then
    echo "$wt"; exit 0
  fi
  mkdir -p "$(dirname "$wt")"
  if git -C "$main" show-ref --verify --quiet "refs/heads/$branch"; then
    git -C "$main" worktree add "$wt" "$branch" >/dev/null
  elif git -C "$main" show-ref --verify --quiet "refs/remotes/origin/$branch"; then
    git -C "$main" worktree add --track -b "$branch" "$wt" "origin/$branch" >/dev/null
  else
    git -C "$main" worktree add -b "$branch" "$wt" ${base:-HEAD} >/dev/null
  fi
  link_context "$main" "$wt"
  register_herdr "$main" "$wt" "$branch"
  echo "$wt"
}

cmd_path() {
  [ -n "${1:-}" ] || die "usage: wt path <branch>"
  git worktree list --porcelain | awk -v b="refs/heads/$1" '
    /^worktree /{p=$2} /^branch /{if($2==b){print p; exit}}' | grep . || die "no worktree for $1"
}

cmd_rm() {
  [ -n "${1:-}" ] || die "usage: wt rm <branch|path>"
  local target="$1"; [ -d "$target" ] || target="$(cmd_path "$1")"
  git worktree remove "$target"
}

case "${1:-}" in
  new)      shift; cmd_new "$@";;
  path)     shift; cmd_path "$@";;
  ls|list)  git worktree list;;
  rm|remove) shift; cmd_rm "$@";;
  link)     main="$(main_checkout)"; wt="$(git rev-parse --show-toplevel)"; [ "$main" != "$wt" ] && link_context "$main" "$wt";;
  register) main="$(main_checkout)"; wt="$(git rev-parse --show-toplevel)"; [ "$main" != "$wt" ] && register_herdr "$main" "$wt" "$(git branch --show-current)";;
  *) sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'; exit 1;;
esac
